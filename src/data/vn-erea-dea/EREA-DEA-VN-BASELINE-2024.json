  "coreDrivers": {
    "policies": "Planned capacity: PDP8 fossil plans to 2030 are kept (30.5 GW coal, 11 GW domestic gas in 2030). Efficiency standards: VNEEP subsector minimum improvements and caps on efficient-appliance shares. Transport mandates: Decision 876 electric or fossil-free new buses (2025) and taxis (2030). Operating rules: coal minimum-operation requirements and no retirement before end of life.",
    "emissionsTargets": "Emissions target to 2030 only: the unconditional NDC (15.8% below BAU in 2030) sets the emission pathway; no target after 2030.",
    "technologyCosts": "Least-cost optimisation means unit costs decide the build-out without climate targets: solar and wind still reach 85% or more of 2050 capacity, 73 GW offshore wind arrives after 2040 as its costs fall, and batteries enter from 2040. Costs from the Viet Nam Technology Catalogues.",
    "investmentChange": "not applicable.",
    "macroeconomicDrivers": "GDP growth of 7%/yr (2021-30) and 6.5%/yr (2030-50), with industry at 40% and services 50% of GDP from 2030, drives a 4.5-fold rise in electricity demand to 1,127 TWh. In BSL this is the dominant demand driver in the absence of a long-term target.",
    "behavioralShifts": "not applicable.",
    "otherDrivers": "Renewable potential limit: land-based solar capped at 136 GW (land allocated by Resolution 39/2021/QH15) and fully used by 2050, which pushes the system to offshore wind and LNG."
  },
  "dependencies": [
    {
      "dependency_name": "Policy strategy",
      "dependency_description": "Grid decarbonisation in BSL rests on PDP8 to 2030 and the unconditional NDC; no climate policy steers the mix after 2030, yet RE still reaches 85%+ of 2050 capacity on cost. Power emissions peak at 173 Mt in 2030, about the JETP 170 Mt ceiling, and the RE share of 46% in 2030 matches JETP's 47% - current plans roughly meet near-term targets but not net zero.",
      "sector": "Power",
      "evidence_type": "Quantitative"
    },
    {
      "dependency_name": "Regulatory framework",
      "dependency_description": "BSL keeps current market rules - PPAs that reward high minimum load, inertia requirements and no early retirement - which hold coal in baseload and lead to curtailment as VRE grows. Table 5.1 lists PPA revision and grid-code changes as the fixes, which BSL does not assume.",
      "sector": "Power",
      "evidence_type": "Qualitative"
    },
    {
      "dependency_name": "Market and economics",
      "dependency_description": "BSL depends most on fuel markets: LNG capacity of 30-35 GW in 2050 and 17% import share of TPES leave power costs exposed to LNG prices tied to Europe/Asia markets (12.5 USD/GJ assumed); +/-25% fuel prices are tested on BSL.",
      "sector": "Power",
      "evidence_type": "Quantitative"
    },
    {
      "dependency_name": "Infrastructure and logistics",
      "dependency_description": "Even BSL needs inter-regional transmission to rise from 27 GW to 48 GW by 2030 and to 81-90 GW by 2050 (28 GW added in 2040-50), plus 78 GW/451 GWh storage and LNG import terminals for up to 650 PJ/yr. Analysis uses hourly Balmorel dispatch in 7 regions and PSS/E grid checks for 2025/2030.",
      "sector": "Power",
      "evidence_type": "Quantitative"
    },
    {
      "dependency_name": "Technology",
      "dependency_description": "BSL relies on batteries only from 2040; pumped hydro covers storage until then, so battery maturity barely constrains it.",
      "sector": "Power",
      "evidence_type": "Quantitative"
    },
    {
      "dependency_name": "Resource availability",
      "dependency_description": "Land-based solar is capped at 136 GW and fully used by 2050; LNG imports reach the 650 PJ/yr maximum in 2040, and land solar in the North is where most land is allocated.",
      "sector": "Power",
      "evidence_type": "Quantitative"
    },
    {
      "dependency_name": "Labor availability",
      "dependency_description": "BSL builds large RE and offshore wind (73 GW) too, but the skills recommendations are framed around the NZ build; flexible-operation training is not assumed.",
      "sector": "Power",
      "evidence_type": "Anecdotal"
    },
    {
      "dependency_name": "Policy strategy",
      "dependency_description": "BSL follows the Viet Nam National Program on Energy Efficiency and Conservation for 2019-2030 minimum efficiency gains for iron and steel to 2030 only; with no long-term target, steel emissions rise from 18.1 to 24.0 Mt by 2050.",
      "sector": "Steel",
      "evidence_type": "Quantitative"
    },
    {
      "dependency_name": "Regulatory framework",
      "dependency_description": "BSL's steel gains rely on VNEEP3 rules (energy audits, management systems, benchmarking), where compliance is low because of weak enforcement; revision of the energy-efficiency law and Circular 25 enforcement are the levers.",
      "sector": "Steel",
      "evidence_type": "Qualitative"
    },
    {
      "dependency_name": "Market and economics",
      "dependency_description": "Iron and steel equals cement as the costliest subsector in BSL by 2050 (~28% of industrial cost); fuel switching to biomass and electricity happens on cost alone.",
      "sector": "Steel",
      "evidence_type": "Quantitative"
    },
    {
      "dependency_name": "Resource availability",
      "dependency_description": "Industry is the main biomass user; the 1,719 PJ potential is 73-100% used by 2050 and its estimate is uncertain.",
      "sector": "Steel",
      "evidence_type": "Quantitative"
    },
    {
      "dependency_name": "Labor availability",
      "dependency_description": "Enterprises lack technical expertise for major efficiency projects.",
      "sector": "Steel",
      "evidence_type": "Anecdotal"
    },
    {
      "dependency_name": "Market and economics",
      "dependency_description": "Part of jet fuel remains imported in 2050 (transport import share 30%).",
      "sector": "Aviation",
      "evidence_type": "Quantitative"
    }
  ],
