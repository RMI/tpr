  "coreDrivers": {
    "policies": "The scenario doesn't follow policies: PDP8 plans only 2.8 of 11 GW of LNG additions. Rail electrification and exogenous modal shift follows local policy. Power operating rules are relaxed: early coal decommissioning and flexible operation from 2030.",
    "emissionsTargets": "Emissions target of 0 Mt for the energy sector in 2050, tighter than the National Climate Change Strategy 101 Mt; only industrial process emissions (~20 Mt) remain.",
    "technologyCosts": "The zero cap forces costlier options: 28 GW SMR (3.5% of capacity but 10% of investment), 135 GW rooftop solar, DAC (10 Mt) and green ammonia; annual system cost in 2050 is the highest of all pathways.",
    "investmentChange": "not applicable.",
    "macroeconomicDrivers": "GDP growth of 7%/yr (2021-30) and 6.5%/yr (2030-50). Electricity demand rises further to ~1,500 TWh because of deeper electrification, not different macro assumptions.",
    "behavioralShifts": "Inherits NZ modal shift and demand flexibility, which offsets much of the extra technology cost so NPV stays close to BSL.",
    "otherDrivers": "Renewable potential: 272 GW land solar plus rooftop potential become binding (73% of RE potential used); nuclear is added where solar and onshore wind are exhausted."
  },
  "dependencies": [
    {
      "dependency_name": "Policy strategy",
      "dependency_description": "NZ+ requires raising ambition beyond the National Climate Change Strategy (energy sector 0 Mt in 2050) and a policy decision on nuclear: 28 GW of SMR from 2040, which the report says needs further investigation before any commitment.",
      "sector": "Power",
      "evidence_type": "Qualitative"
    },
    {
      "dependency_name": "Regulatory framework",
      "dependency_description": "As NZ, with offshore wind entering in 2035 and rooftop solar reaching 135 GW, which needs grid-connection standards for rooftop PV; SMR introduction would need a nuclear regulatory regime the report does not detail.",
      "sector": "Power",
      "evidence_type": "Qualitative"
    },
    {
      "dependency_name": "Market and economics",
      "dependency_description": "NZ+ needs the largest capital outlay - nuclear alone is 10% of 2025-2050 power investment - and has the highest annual system cost in 2050.",
      "sector": "Power",
      "evidence_type": "Quantitative"
    },
    {
      "dependency_name": "Infrastructure and logistics",
      "dependency_description": "NZ+ needs 154 GW/1,372 GWh storage, a 22 GW SC-SE link and the largest hydrogen network (55 GW electrolysers); SMRs are sited in North/South East to avoid extra transmission.",
      "sector": "Power",
      "evidence_type": "Quantitative"
    },
    {
      "dependency_name": "Technology",
      "dependency_description": "NZ+ depends on 28 GW of SMR, an emerging technology with high cost and timeline uncertainty in a country with no nuclear today, plus 128 GW batteries.",
      "sector": "Power",
      "evidence_type": "Qualitative"
    },
    {
      "dependency_name": "Resource availability",
      "dependency_description": "NZ+ depends on doubling land for utility PV to 272 GW (~3,000 km2, 0.9% of Viet Nam land). NZ+ uses 73% of RE potential incl. rooftop, and adds nuclear where solar and onshore wind are exhausted, creating reliance on imported nuclear fuel.",
      "sector": "Power",
      "evidence_type": "Quantitative"
    },
    {
      "dependency_name": "Environmental impacts and ecosystem services",
      "dependency_description": "Planning reserves account for climate-related lower hydro and RE output and higher temperature-driven demand; this was modelled only in the NZ-Reserve sensitivity, adding 42 GW hydrogen-fired reserve plants. Low reservoir levels are cited as a stress case for flexibility.",
      "sector": "Power",
      "evidence_type": "Anecdotal"
    },
    {
      "dependency_name": "Labor availability",
      "dependency_description": "NZ+ adds 28 GW of SMR, a 'highly specialized technology' with no domestic know-how, on top of a larger RE fleet, in need of a skilled workforce.",
      "sector": "Power",
      "evidence_type": "Qualitative"
    },
    {
      "dependency_name": "Policy strategy",
      "dependency_description": "Steel emissions must halve to 9.3 Mt; NZ+ fully decarbonises 7 of 14 subsectors and needs the green-steel and coal phase-out policies the report recommends.",
      "sector": "Steel",
      "evidence_type": "Quantitative"
    },
    {
      "dependency_name": "Regulatory framework",
      "dependency_description": "As NZ, with deeper cuts needing the carbon market to bind.",
      "sector": "Steel",
      "evidence_type": "Qualitative"
    },
    {
      "dependency_name": "Market and economics",
      "dependency_description": "Deeper steel cuts rely on costlier H2 and electrification; same CBAM and carbon-market exposure.",
      "sector": "Steel",
      "evidence_type": "Qualitative"
    },
    {
      "dependency_name": "Infrastructure and logistics",
      "dependency_description": "Largest hydrogen system (573 PJ, 55 GW electrolysers) and grid to electrify 73% of industrial FEC.",
      "sector": "Steel",
      "evidence_type": "Quantitative"
    },
    {
      "dependency_name": "Technology",
      "dependency_description": "Halving steel emissions needs H2 routes at scale after 2040.",
      "sector": "Steel",
      "evidence_type": "Qualitative"
    },
    {
      "dependency_name": "Resource availability",
      "dependency_description": "NZ+ uses the most biomass in transport, leaving industry more reliant on electricity and H2.",
      "sector": "Steel",
      "evidence_type": "Qualitative"
    },
    {
      "dependency_name": "Labor availability",
      "dependency_description": "Report recommends education programmes targeting the highest-emitting industries.",
      "sector": "Steel",
      "evidence_type": "Anecdotal"
    },
    {
      "dependency_name": "Policy strategy",
      "dependency_description": "With energy emissions at zero, aviation fuels must be decarbonised; additional policy targets for e-fuels are needed.",
      "sector": "Aviation",
      "evidence_type": "Qualitative"
    },
    {
      "dependency_name": "Market and economics",
      "dependency_description": "All jet fuel is imported in 2050, exposing aviation to international fuel markets.",
      "sector": "Aviation",
      "evidence_type": "Quantitative"
    },
    {
      "dependency_name": "Consumer and client behavior",
      "dependency_description": "Modal shift moves some passenger and freight demand from aviation to rail, which needs incentives differentiated for passenger and freight; the shift is an exogenous assumption, not a modelled behavioural response.",
      "sector": "Aviation",
      "evidence_type": "Qualitative"
    },
    {
      "dependency_name": "Infrastructure and logistics",
      "dependency_description": "Adds hydrogen supply chains for non-road transport on top of the rail roadmap.",
      "sector": "Aviation",
      "evidence_type": "Qualitative"
    },
    {
      "dependency_name": "Technology",
      "dependency_description": "Deeper aviation decarbonisation depends on H2 and e-fuel routes maturing.",
      "sector": "Aviation",
      "evidence_type": "Qualitative"
    },
    {
      "dependency_name": "Resource availability",
      "dependency_description": "Transport takes half or more of bioenergy in NZ+, and imported jet fuel is needed.",
