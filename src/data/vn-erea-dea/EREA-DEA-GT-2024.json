  "coreDrivers": {
    "policies": "Contrarily to other NZ scenario, the scenario follows PDP8 2030 LNG additions. Coal peaked in 2030 as in BSL. Deeper electrification happens in the Transport sector, including rail electrification and exogenous modal shifts implemented in other NZ scenario.",
    "emissionsTargets": "Same National Climate Change Strategy caps as NZ (101 Mt energy + 20 Mt process in 2050); identical by design because Green Transport assumes higher change in the Transport sector, not in scenario ambition.",
    "technologyCosts": "Least-cost choice under tight transport and land limits buys costly RE-fuels (methanol for trucks and ships, RE-jet fuel) while power decarbonises more slowly, raising the cost of net zero.",
    "investmentChange": "not applicable.",
    "macroeconomicDrivers": "GDP growth of 7%/yr (2021-30) and 6.5%/yr (2030-50), with industry at 40% and services 50% of GDP from 2030.",
    "behavioralShifts": "Inherits NZ modal shift; transport electricity reaches 408 TWh in 2050.",
    "otherDrivers": "Renewable potential cut to 136 GW land-based solar, fully used by 2050, slowing power decarbonisation and lifting cumulative emissions 7% above NZ."
  },
  "dependencies": [
    {
      "dependency_name": "Policy strategy",
      "dependency_description": "GT shows the cost of misaligned policy - full Decision 876 for transport while power keeps PDP8 fossil plans to 2030 (coal peak 30.5 GW as in BSL); the report recommends matching RE-integration targets to transport targets.",
      "sector": "Power",
      "evidence_type": "Qualitative"
    },
    {
      "dependency_name": "Regulatory framework",
      "dependency_description": "GT keeps PDP8-era rules to 2030 (no committed-only LNG, BSL-like coal peak), so flexibility reform arrives later while 1,355 TWh must be generated by 2050; inference from GT's BSL-like 2030 power outcome.",
      "sector": "Power",
      "evidence_type": "Anecdotal"
    },
    {
      "dependency_name": "Market and economics",
      "dependency_description": "GT reaches net zero at higher cost than NZ because power decarbonises more slowly while transport buys expensive RE-fuels; earlier fossil build-out raises stranded-asset exposure.",
      "sector": "Power",
      "evidence_type": "Qualitative"
    },
    {
      "dependency_name": "Infrastructure and logistics",
      "dependency_description": "GT combines the all-scenario grid expansion with EV charging and distribution reinforcement for 408 TWh of transport load, with land solar capped so more power must travel from wind regions.",
      "sector": "Power",
      "evidence_type": "Quantitative"
    },
    {
      "dependency_name": "Technology",
      "dependency_description": "GT relies on batteries from 2040 and 3 GW of SMR; land-solar limits raise dependence on storage timing.",
      "sector": "Power",
      "evidence_type": "Qualitative"
    },
    {
      "dependency_name": "Resource availability",
      "dependency_description": "GT is limited and fully uses 136 GW land solar as set in local Resolution, and also exhausts rooftop potential, slowing power decarbonisation.",
      "sector": "Power",
      "evidence_type": "Quantitative"
    },
    {
      "dependency_name": "Environmental impacts and ecosystem services",
      "dependency_description": "Planning reserves account for climate-related lower hydro and RE output and higher temperature-driven demand; this was modelled only in the NZ-Reserve sensitivity, adding 42 GW hydrogen-fired reserve plants. Low reservoir levels are cited as a stress case for flexibility.",
      "sector": "Power",
      "evidence_type": "Anecdotal"
    },
    {
      "dependency_name": "Labor availability",
      "dependency_description": "NZ-type RE skills plus EV-charging and grid-reinforcement work.",
      "sector": "Power",
      "evidence_type": "Anecdotal"
    },
    {
      "dependency_name": "Policy strategy",
      "dependency_description": "In GT steel emissions rise to 27.3 Mt - the cap's budget is used by industry while transport is near zero - so steel-specific decarbonisation policy is barely exercised. Evidence-based inference.",
      "sector": "Steel",
      "evidence_type": "Quantitative"
    },
    {
      "dependency_name": "Regulatory framework",
