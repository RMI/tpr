      "sector": "Steel",
      "evidence_type": "Anecdotal"
    },
    {
      "dependency_name": "Infrastructure and logistics",
      "dependency_description": "Steel uses little new infrastructure in GT. Inference.",
      "sector": "Steel",
      "evidence_type": "Anecdotal"
    },
    {
      "dependency_name": "Technology",
