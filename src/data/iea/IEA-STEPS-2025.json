  "coreDrivers": {
    "policies": "STEPS is driven by current policies plus formally tabled policies and official strategies, including carbon pricing, standards, subsidies, technology targets, phaseouts, tariffs/rate design and other market/regulatory policies.",
    "emissionsTargets": null,
    "technologyCosts": "Technology costs affect outcomes through learning-by-doing; faster clean technology deployment than CPS lowers costs faster and supports more renewables, electrification and storage.",
    "investmentChange": "Average annual energy investment in 2025-2035 rises to over USD 3.4 trillion, with greater spending on renewables, grids/storage, efficiency and electrification than CPS.",
    "macroeconomicDrivers": "GDP and population assumptions are common across scenarios; economic growth and emerging-market demand drive energy-service growth, but policies and technology adoption moderate final energy demand relative to CPS.",
    "behavioralShifts": null,
    "otherDrivers": "Energy security, LNG market balances, grid integration, critical minerals and data centre/cooling demand are important contextual drivers and dependencies shaping STEPS outcomes."
  },
  "dependencies": [
    {
      "dependency_name": "Policy strategy",
      "dependency_description": "High: Broader stated policies and strategies support faster renewables, efficiency, electrification and grid reforms than CPS, making policy delivery a key enabler. Mode: Explicit.",
      "sector": "Power",
      "evidence_type": "Qualitative"
    },
    {
      "dependency_name": "Regulatory framework",
      "dependency_description": "High: Market reforms, permitting and grid-connection regulation remain material because renewables, storage and flexibility scale faster than CPS. Mode: Explicit and quantitative proxy.",
      "sector": "Power",
      "evidence_type": "Qualitative"
    },
    {
      "dependency_name": "Market and economics",
      "dependency_description": "Moderate: Declining renewables and battery costs support deployment, while well-supplied LNG markets lower gas prices and shape dispatch/investment decisions. Mode: Explicit.",
      "sector": "Power",
      "evidence_type": "Quantitative"
    },
    {
      "dependency_name": "Public acceptance",
      "dependency_description": "Moderate: Faster build-out of renewables, grids, storage and nuclear increases siting/permitting exposure, but WEO does not present public acceptance as the dominant STEPS constraint. Mode: Scenario-design inference.",
      "sector": "Power",
      "evidence_type": "Anecdotal"
    },
    {
      "dependency_name": "Consumer and client behavior",
      "dependency_description": "Moderate: Greater electrification increases the need for demand flexibility, smart charging and efficient appliances to control peak demand and affordability. Mode: Explicit.",
      "sector": "Power",
      "evidence_type": "Qualitative"
    },
    {
      "dependency_name": "Infrastructure and logistics",
      "dependency_description": "High: STEPS requires rapid grid, storage and flexibility build-out; battery capacity reaches about 1 700 GW by 2035 and short-term flexibility needs rise two- to seven-fold. Mode: Quantitative proxy.",
      "sector": "Power",
      "evidence_type": "Quantitative"
    },
    {
      "dependency_name": "Technology",
      "dependency_description": "Moderate: The pathway relies on continued cost declines and deployment of commercially scaling technologies without assuming major breakthroughs. Mode: Explicit.",
      "sector": "Power",
      "evidence_type": "Qualitative"
    },
    {
      "dependency_name": "Resource availability",
      "dependency_description": "High: Critical minerals and clean technology value-chain concentration materially affect renewables, batteries and grids as deployment accelerates. Mode: Explicit.",
      "sector": "Power",
      "evidence_type": "Qualitative"
    },
    {
      "dependency_name": "Environmental impacts and ecosystem services",
      "dependency_description": "High: Weather-related outages, high temperatures and water constraints affect electricity reliability; STEPS exceeds 1.5°C around 2030 and reaches about 2.5°C by 2100. Mode: Explicit.",
      "sector": "Power",
      "evidence_type": "Qualitative"
    },
    {
      "dependency_name": "Labor availability",
      "dependency_description": "Cannot assess: Larger grid/storage/renewables build-out implies workforce needs, but pathway-specific power-sector labor constraints are not quantified in the attached materials. Mode: Scenario-design inference.",
      "sector": "Power",
      "evidence_type": "Anecdotal"
    }
  ]
